 {"id": "c1_map", "type": "answermap", "question": "Are ALL AGREEMENTS CONTRACTS? Who is competent? Must contracts be WRITTEN?", "sub": "ss. 2, 9, 10, 11, 12 · Contract Act 1872",
  "intro": "Correct the statement first: an agreement is a contract only if it satisfies s. 10 — every contract is an agreement, but not every agreement a contract.",
  "left": [
   {"title": "(1) Introduction", "bullets": ["Statement only half true", "s. 10 — 'if' conditions"]},
   {"title": "(2) The s. 2 ladder", "bullets": ["Proposal → promise → agreement", "Enforceable agreement = contract"]},
   {"title": "(3)–(4) Agreement + intention", "bullets": ["Absolute acceptance (Hyde v. Wrench)", "Legal relations (Balfour v. Balfour)"]},
   {"title": "(5) Free consent", "bullets": ["ss. 13–22; voidable / void"]},
   {"title": "(6) Competent parties", "bullets": ["Majority 18 / 21; sound mind (s. 12)", "Minor void (Mohori Bibee); disqualified"]},
   {"title": "(7) Lawful consideration", "bullets": ["Durga Prasad; Chinnaya; s. 25"]}
  ],
  "right": [
   {"title": "(8) Lawful object", "bullets": ["s. 23 six heads"]},
   {"title": "(9)–(10) Not declared void", "bullets": ["ss. 24–30A, 36, 56", "Certainty (s. 29); possibility"]},
   {"title": "(11) Writing?", "bullets": ["Generally no — s. 9 express / implied", "Unless law requires: s. 25, TPA, Registration Act, Art. 17 QSO"]},
   {"title": "(12) Illustration", "bullets": ["Oral cement sale valid", "Sale of plot needs registered deed"]},
   {"title": "(13) Conclusion", "bullets": ["Every contract an agreement — not vice versa"]}
  ]},
 {"id": "c2_map", "type": "answermap", "question": "OFFER, ACCEPTANCE, INVITATION TO TREAT, REVOCATION — are BIDS offers?", "sub": "ss. 2(a)–(b), 4–8 · Contract Act 1872",
  "intro": "Define each term with a case, fix the timing under ss. 4–6, then answer clearly: an advertisement inviting bids is an invitation; each bid is an offer.",
  "left": [
   {"title": "(1) Introduction", "bullets": ["Offer vs invitation decides when a contract is made"]},
   {"title": "(2) Offer — s. 2(a)", "bullets": ["Willingness + view to assent", "Knowledge (Lalman Shukla); general offer (Carlill)"]},
   {"title": "(3) Acceptance — ss. 7, 8", "bullets": ["Absolute (Hyde v. Wrench)", "Communicated (Felthouse); by performance"]},
   {"title": "(4) Invitation to treat", "bullets": ["Boots; Harvey v. Facey; Spencer v. Harding", "Auctions, catalogues, tenders"]},
   {"title": "(5) Communication — s. 4", "bullets": ["Posting binds proposer", "Instantaneous: Entores; Bhagwandas Kedia"]}
  ],
  "right": [
   {"title": "(6) Revocation — s. 5", "bullets": ["Proposal until acceptance posted", "Acceptance until it reaches proposer"]},
   {"title": "(7) Modes — s. 6", "bullets": ["Notice; lapse; condition; death / insanity"]},
   {"title": "(8) Bids by advertisement", "bullets": ["Invitation; bid = offer; letter of acceptance", "Harvela exception; auctions; PPRA Rules 2004"]},
   {"title": "(9) Illustration", "bullets": ["CDA tender; bid withdrawn before acceptance"]},
   {"title": "(10) Conclusion", "bullets": ["Bids are offers; advertisement is an invitation"]}
  ]},
 {"id": "c3_map", "type": "answermap", "question": "FAROOQ v. JAVAID — was a contract made by e-mail, and who can sue?", "sub": "ss. 2, 4–7, 39, 73, 75 · LHC 2017",
  "intro": "Label each message; fix when the e-mail acceptance took effect; then decide whether Farooq accepted Javaid's anticipatory breach.",
  "left": [
   {"title": "(1)–(2) Issues and law", "bullets": ["ss. 2(a), 4–7, 39; ETO 2002"]},
   {"title": "(3) First e-mail", "bullets": ["Offer of Rs. 1.5 m (s. 2(a))"]},
   {"title": "(4) Javaid's reply", "bullets": ["Counter-offer (Hyde v. Wrench)", "or inquiry (Stevenson v. McLean)?"]},
   {"title": "(5) 'Yes. Consider it sold'", "bullets": ["Absolute acceptance at Rs. 1.8 m", "Not silence (Felthouse distinguished)"]},
   {"title": "(6) When formed?", "bullets": ["On receipt (Entores); SGA s. 20"]}
  ],
  "right": [
   {"title": "(7) No revocation", "bullets": ["Too late (s. 5); not communicated (s. 6)"]},
   {"title": "(8) Sale to another", "bullets": ["Disablement — s. 39", "Anticipatory breach (Hochster)"]},
   {"title": "(9) Accepted or affirmed?", "bullets": ["Farooq treated contract as ended", "Contrast Avery v. Bowden"]},
   {"title": "(10) Remedies", "bullets": ["Javaid cannot compel", "Farooq: s. 73, 75; mitigation"]},
   {"title": "(11) Conclusion", "bullets": ["Contract made, breached, ended"]}
  ]},
 {"id": "c4_map", "type": "answermap", "question": "Agreements without consideration are VOID — what are the EXCEPTIONS in s. 25?", "sub": "s. 25 with illustrations (a)–(g)",
  "intro": "State the rule, then the three exceptions with their conditions, the two Explanations, and place every illustration under its rule.",
  "left": [
   {"title": "(1) The rule", "bullets": ["Ex nudo pacto non oritur actio", "Illus. (a): bare promise void"]},
   {"title": "(2) Meaning of consideration", "bullets": ["s. 2(d); Durga Prasad; Chinnaya"]},
   {"title": "(3) Natural love and affection", "bullets": ["Written + registered + near relation", "Illus. (b); Rajlukhy Dabee"]},
   {"title": "(4) Past voluntary service", "bullets": ["Promise to compensate", "Illus. (c) purse; (d) infant son"]}
  ],
  "right": [
   {"title": "(5) Time-barred debt", "bullets": ["Written, signed promise to pay", "Illus. (e); vs s. 19 Limitation Act"]},
   {"title": "(6) Explanation 1", "bullets": ["Completed gift valid"]},
   {"title": "(7) Explanation 2", "bullets": ["Inadequacy — evidence of free consent", "Illus. (f), (g)"]},
   {"title": "(8) Elsewhere in the Act", "bullets": ["ss. 63, 127, 185; bailment", "Kedarnath vs Abdul Aziz"]},
   {"title": "(9) Conclusion", "bullets": ["Rule + three exceptions + two Explanations"]}
  ]},
 {"id": "c5_map", "type": "answermap", "question": "Agreements by MINORS and persons of UNSOUND MIND — law and effects", "sub": "ss. 10–12, 64–65, 68 · Majority Act s. 3 · SRA s. 41",
  "intro": "Competence is an essential; a minor's agreement is void ab initio; unsoundness is tested at the time of contracting; necessaries come from property.",
  "left": [
   {"title": "(1) Capacity — s. 11", "bullets": ["Majority + sound mind + not disqualified"]},
   {"title": "(2) Who is a minor", "bullets": ["18; 21 with court guardian"]},
   {"title": "(3) Void ab initio", "bullets": ["Mohori Bibee — four points"]},
   {"title": "(4) Effects", "bullets": ["No ratification; no estoppel (Sadiq Ali Khan)", "Restitution (Khan Gul) vs Ajudhia Prasad", "No specific performance; beneficiary; agent; guardian"]},
   {"title": "(5) Necessaries — s. 68", "bullets": ["From property only (Nash v. Inman)"]}
  ],
  "right": [
   {"title": "(6) Unsound mind — s. 12", "bullets": ["Understanding + rational judgment", "Lucid intervals; drunkenness; burden"]},
   {"title": "(7) Effects", "bullets": ["Void; s. 68; manager (MHO 2001)", "Weakness → undue influence s. 16(2)(b)"]},
   {"title": "(8) Comparison table", "bullets": ["Minor vs unsound mind"]},
   {"title": "(9) Illustration", "bullets": ["17-year-old's motorcycle purchase"]},
   {"title": "(10) Conclusion", "bullets": ["Protection at the other party's risk"]}
  ]},
